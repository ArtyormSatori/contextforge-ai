    "@forge/resolver": "^2.0.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "js-yaml": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
